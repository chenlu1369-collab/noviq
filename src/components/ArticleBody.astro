---
import type { ArticleContentBlock, ArticleInlineToken } from '../types/article';

interface Props {
  blocks: ArticleContentBlock[];
}

const { blocks } = Astro.props;
---

<div class="article-body">
  {blocks.map((block) => (
    <>
      {block.type === 'paragraph' && <p>{block.parts ? block.parts.map((part: ArticleInlineToken) => part.type === 'strong' ? <strong>{part.text}</strong> : part.type === 'emphasis' ? <em>{part.text}</em> : part.type === 'code' ? <code>{part.text}</code> : part.type === 'link' ? <a href={part.href}>{part.text}</a> : part.text) : block.text}</p>}
      {block.type === 'heading' && block.level === 2 && <h2 id={block.id}>{block.text}</h2>}
      {block.type === 'heading' && block.level === 3 && <h3 id={block.id}>{block.text}</h3>}
      {block.type === 'image' && (
        <figure>
          <img src={block.src} alt={block.alt} loading="lazy" />
          {block.caption && <figcaption>{block.caption}</figcaption>}
        </figure>
      )}
      {block.type === 'list' && block.ordered && (
        <ol>{block.items.map((item) => <li>{item}</li>)}</ol>
      )}
      {block.type === 'list' && !block.ordered && (
        <ul>{block.items.map((item) => <li>{item}</li>)}</ul>
      )}
      {block.type === 'table' && (
        <div class="table-scroll" role="region" aria-label={block.caption} tabindex="0">
          <table>
            {block.caption && <caption>{block.caption}</caption>}
            <thead><tr>{block.headers.map((heading) => <th scope="col">{heading}</th>)}</tr></thead>
            <tbody>{block.rows.map((row) => <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody>
          </table>
        </div>
      )}
    </>
  ))}
</div>

<style>
  .article-body{color:#303847;font-size:18px;line-height:1.78}
  .article-body p{margin:0 0 1.35em}
  .article-body h2{scroll-margin-top:24px;margin:2.35em 0 .7em;color:#171b24;font:700 clamp(26px,3vw,34px)/1.2 'Manrope',sans-serif;letter-spacing:-.04em}
  .article-body h3{scroll-margin-top:24px;margin:1.9em 0 .6em;color:#202a3a;font:650 23px/1.3 'Manrope',sans-serif;letter-spacing:-.025em}
  .article-body ul,.article-body ol{margin:0 0 1.5em;padding-left:1.35em}
  .article-body li{padding-left:.25em;margin:.45em 0}
  .article-body li::marker{color:#4263d5}
  .article-body a{color:#344fae;text-decoration:underline;text-decoration-color:#a9b7e8;text-underline-offset:3px}
  .article-body a:hover{color:#4263d5}
  .article-body code{padding:.12em .35em;border-radius:4px;background:#e9edf3;font-size:.88em}
  .article-body figure{margin:2em 0}
  .article-body figure img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:14px;background:#e5e9ef}
  .article-body figcaption{margin-top:10px;color:#687386;font-size:14px;line-height:1.5}
  .table-scroll{overflow-x:auto;margin:1.8em 0;border:1px solid #e2e6ed;border-radius:12px;background:#fff}
  .article-body table{width:100%;border-collapse:collapse;font-size:15px;line-height:1.55}
  .article-body caption{text-align:left;padding:16px 18px;color:#171b24;font-weight:700}
  .article-body th,.article-body td{text-align:left;vertical-align:top;padding:13px 18px;border-top:1px solid #e2e6ed}
  .article-body thead th{background:#f5f6f8;color:#354054;font-weight:700}
  .article-body tbody th{min-width:120px;color:#202a3a;font-weight:600}
  @media(max-width:640px){.article-body{font-size:17px;line-height:1.72}.article-body h2{font-size:27px}.article-body h3{font-size:21px}.article-body th,.article-body td{padding:11px 13px}}
</style>
