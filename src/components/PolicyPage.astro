---
import Layout from '../layouts/Layout.astro';

interface PolicySection {
  heading: string;
  paragraphs?: string[];
  items?: string[];
}

interface Props {
  title: string;
  description: string;
  sections: PolicySection[];
}

const { title, description, sections } = Astro.props;
const updated = 'November 20, 2026';
---

<Layout title={`${title} | NOVIQ`} description={description}>
  <main class="policy-page">
    <div class="policy-shell">
      <header class="policy-header">
        <p class="policy-kicker">NOVIQ POLICIES</p>
        <h1>{title}</h1>
        <p class="policy-updated">Last updated: {updated}</p>
      </header>
      <article class="policy-content">
        {sections.map((section) => (
          <section class="policy-section">
            <h2>{section.heading}</h2>
            {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            {section.items && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}
          </section>
        ))}
        <p class="policy-draft">These policy pages are informational drafts and may be updated as NOVIQ’s services and practices develop. They are not a statement that the site meets every legal requirement in every jurisdiction.</p>
      </article>
    </div>
  </main>
</Layout>

<style>
  .policy-page{min-height:60vh;padding:66px 24px 88px;background:#f5f6f8;color:#171b24}
  .policy-shell{width:min(920px,100%);margin:0 auto}
  .policy-header{padding-bottom:28px;border-bottom:1px solid #e2e6ed}
  .policy-kicker{margin:0 0 12px;color:#4263d5;font-size:12px;font-weight:700;letter-spacing:.1em}
  .policy-header h1{margin:0;color:#171b24;font:750 clamp(38px,5vw,54px)/1.08 'Manrope',sans-serif;letter-spacing:-.05em}
  .policy-updated{margin:15px 0 0;color:#687386;font-size:14px}
  .policy-content{max-width:780px;padding-top:13px}
  .policy-section{padding:25px 0 22px;border-bottom:1px solid #e2e6ed}
  .policy-section h2{margin:0 0 12px;color:#202a3a;font:700 23px/1.3 'Manrope',sans-serif;letter-spacing:-.025em}
  .policy-section p,.policy-section li,.policy-draft{color:#4e5a6d;font-size:17px;line-height:1.72}
  .policy-section p{margin:0 0 13px}
  .policy-section p:last-child{margin-bottom:0}
  .policy-section ul{display:grid;gap:8px;margin:12px 0 0;padding-left:24px}
  .policy-section li{padding-left:3px}
  .policy-draft{margin:28px 0 0;padding:16px 18px;border-left:3px solid #4263d5;background:#fff;font-size:14px;line-height:1.65}
  @media(max-width:640px){.policy-page{padding:46px 20px 64px}.policy-section{padding:21px 0 19px}.policy-section h2{font-size:21px}.policy-section p,.policy-section li{font-size:16px}}
</style>
