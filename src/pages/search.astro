---
import Layout from '../layouts/Layout.astro';
import { articles } from '../data/articles';
---

<Layout
  title="Search | NOVIQ"
  description="Search NOVIQ reviews and practical technology buying guides."
  noindex={true}
>
  <main class="search-page">
    <div class="search-container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Search</span></nav>
      <header class="search-intro">
        <h1>Search NOVIQ</h1>
        <p>Find reviews and practical buying guides for the technology you’re considering.</p>
      </header>

      <form class="search-form" id="results-search-form" action="/search/" method="get" role="search">
        <label class="sr-only" for="results-search-input">Search article titles, summaries, and categories</label>
        <input id="results-search-input" name="q" type="search" placeholder="Search articles..." autocomplete="off" />
        <button type="submit"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg><span>Search</span></button>
      </form>

      <p class="search-status" id="search-status" aria-live="polite">Enter a keyword to search NOVIQ articles.</p>

      <section class="search-results" aria-label="Search results">
        {articles.map((article) => {
          const href = `/reviews/${article.slug}/`;
          return <article class="search-result" data-search-result data-search={`${article.title} ${article.summary} ${article.category}`.toLocaleLowerCase()} hidden>
            <a class="result-image" href={href} tabindex="-1" aria-hidden="true"><img src={article.coverImage} alt="" loading="lazy" /></a>
            <div class="result-copy">
              <p class="result-category">{article.category}</p>
              <h2><a href={href}>{article.title}</a></h2>
              <p class="result-summary">{article.summary}</p>
              <a class="result-link" href={href}>Read Review <span aria-hidden="true">→</span></a>
            </div>
          </article>;
        })}
      </section>

      <p class="search-empty" id="search-empty" hidden>No results found.</p>
      <noscript><p class="search-noscript">Enable JavaScript to search the article library.</p></noscript>
    </div>
  </main>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#results-search-form');
  const input = document.querySelector<HTMLInputElement>('#results-search-input');
  const status = document.querySelector<HTMLElement>('#search-status');
  const emptyState = document.querySelector<HTMLElement>('#search-empty');
  const results = Array.from(document.querySelectorAll<HTMLElement>('[data-search-result]'));

  const normalize = (value: string) => value
    .normalize('NFKD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLocaleLowerCase()
    .trim();

  const readQuery = () => new URLSearchParams(window.location.search).get('q') ?? '';

  const runSearch = (rawQuery: string) => {
    const query = normalize(rawQuery);
    const terms = query.split(/\s+/).filter(Boolean);
    let matchCount = 0;

    for (const result of results) {
      const searchableText = normalize(result.dataset.search ?? '');
      const matches = terms.length > 0 && terms.every((term) => searchableText.includes(term));
      result.hidden = !matches;
      if (matches) matchCount += 1;
    }

    if (status) status.textContent = terms.length
      ? `${matchCount} ${matchCount === 1 ? 'result' : 'results'} for “${rawQuery.trim()}”`
      : 'Enter a keyword to search NOVIQ articles.';
    if (emptyState) emptyState.hidden = terms.length === 0 || matchCount > 0;
  };

  if (input) input.value = readQuery();
  runSearch(readQuery());

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const query = input?.value.trim() ?? '';
    const url = new URL('/search/', window.location.origin);
    if (query) url.searchParams.set('q', query);
    window.location.assign(url);
  });
</script>

<style>
  .search-page{min-height:68vh;padding:42px 24px 90px;background:#f5f6f8;color:#171b24}
  .search-container{width:min(1080px,100%);margin:0 auto}
  .breadcrumbs{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 32px;color:#687386;font-size:14px}
  .breadcrumbs a:hover{color:#4263d5}
  .search-intro{margin:0 0 26px}
  .search-intro h1{margin:0;color:#171b24;font:750 clamp(38px,4.5vw,52px)/1.08 'Manrope',sans-serif;letter-spacing:-.05em}
  .search-intro>p{max-width:620px;margin:14px 0 0;color:#566174;font-size:17px;line-height:1.6}
  .search-form{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;padding:8px;border:1px solid #d9e0ea;border-radius:12px;background:#fff;box-shadow:0 8px 26px #17233f0a}
  .search-form input{width:100%;min-width:0;min-height:50px;padding:0 14px;border:0;outline:0;background:transparent;color:#171b24;font-size:16px}
  .search-form input::placeholder{color:#7b8798}
  .search-form:focus-within{border-color:#91a5e8;box-shadow:0 0 0 3px #4263d51a}
  .search-form button{display:inline-flex;min-width:120px;min-height:48px;align-items:center;justify-content:center;gap:9px;border:0;border-radius:8px;background:#4263d5;color:#fff;font-size:15px;font-weight:700;cursor:pointer;transition:background .18s}
  .search-form button:hover{background:#3452bb}
  .search-form button svg{width:18px;fill:none;stroke:currentColor;stroke-width:1.8}
  .search-status{min-height:24px;margin:24px 0 16px;color:#566174;font-size:15px}
  .search-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
  .search-result{min-width:0;overflow:hidden;border:1px solid #e0e5ed;border-radius:14px;background:#fff;transition:transform .2s,box-shadow .2s}
  .search-result[hidden]{display:none}
  .search-result:hover{transform:translateY(-2px);box-shadow:0 12px 28px #17233f12}
  .result-image{display:block;aspect-ratio:16/9;overflow:hidden;background:#dfe4eb}
  .result-image img{width:100%;height:100%;object-fit:cover}
  .result-copy{padding:20px 21px 22px}
  .result-category{margin:0;color:#4263d5;font-size:13px;font-weight:700;letter-spacing:.04em}
  .result-copy h2{margin:9px 0 8px;color:#171b24;font:650 clamp(20px,2vw,24px)/1.32 'Manrope',sans-serif;letter-spacing:-.025em}
  .result-copy h2 a:hover{color:#3452bb}
  .result-summary{min-height:3.2em;margin:0;color:#566174;font-size:15px;line-height:1.6}
  .result-link{display:inline-flex;align-items:center;gap:8px;margin-top:16px;color:#4263d5;font-size:15px;font-weight:700}
  .result-link span{transition:transform .18s}
  .result-link:hover span{transform:translateX(3px)}
  .search-empty,.search-noscript{margin:0;padding:22px;border:1px solid #e0e5ed;border-radius:12px;background:#fff;color:#566174;font-size:16px;line-height:1.6}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  @media(max-width:760px){.search-page{padding:34px 20px 68px}.search-results{grid-template-columns:1fr;gap:16px}.result-copy{padding:18px}.result-summary{min-height:0}}
  @media(max-width:420px){.search-form{grid-template-columns:minmax(0,1fr);padding:7px}.search-form input{min-height:48px}.search-form button{width:100%}.search-intro>p{font-size:16px}}
</style>
