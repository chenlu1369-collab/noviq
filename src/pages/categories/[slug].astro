---
import Layout from '../../layouts/Layout.astro';
import { categories } from '../../data/homepage';
import { articles } from '../../data/articles';
import type { Article } from '../../types/article';

export function getStaticPaths() {
  return categories.map((category) => {
    const slug = category.href.replace(/^\/categories\//, '');
    const categoryArticles = articles.filter((article) => article.categorySlug === slug);
    return { params: { slug }, props: { category, articles: categoryArticles } };
  });
}

const { category, articles } = Astro.props as {
  category: { title: string; href: string };
  articles: Article[];
};
const description = `Explore NOVIQ ${category.title.toLowerCase()} reviews and practical buying guides.`;
---

<Layout title={`${category.title} Reviews & Guides | NOVIQ`} description={description}>
  <main class="category-page">
    <div class="category-container">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>{category.title}</span></nav>
      <header class="category-header">
        <p class="category-kicker">NOVIQ CATEGORY</p>
        <h1>{category.title}</h1>
        <p>Reviews and practical guides to help you make more informed {category.title.toLowerCase()} choices.</p>
      </header>

      {articles.length > 0 ? (
        <section class="article-list" aria-label={`${category.title} articles`}>
          {articles.map((article) => (
            <article class="category-article">
              <a class="article-image" href={`/reviews/${article.slug}/`}><img src={article.coverImage} alt={article.coverAlt} loading="lazy" /></a>
              <div class="article-copy">
                <p class="article-label">{article.category}</p>
                <h2><a href={`/reviews/${article.slug}/`}>{article.title}</a></h2>
                <p class="article-summary">{article.summary}</p>
                <div class="article-meta">{article.author && <span>{article.author}</span>}<time datetime={article.publishedAt}>{article.publishedLabel}</time><span>{article.readingTime}</span></div>
              </div>
            </article>
          ))}
        </section>
      ) : (
        <section class="empty-state" aria-live="polite">
          <h2>New guides are on the way.</h2>
          <p>There are no {category.title.toLowerCase()} articles yet. Check back soon for new reviews and buying advice.</p>
        </section>
      )}
    </div>
  </main>
</Layout>

<style>
  .category-page{min-height:60vh;padding:38px 24px 96px;background:#f5f6f8;color:#171b24}
  .category-container{width:min(1160px,100%);margin:0 auto}
  .breadcrumbs{display:flex;gap:10px;margin:0 0 42px;color:#687386;font-size:14px}
  .breadcrumbs a:hover{color:#4263d5}
  .category-header{max-width:760px;margin:0 0 44px}
  .category-kicker{margin:0 0 12px;color:#4263d5;font-size:13px;font-weight:700;letter-spacing:.1em}
  .category-header h1{margin:0 0 13px;color:#171b24;font:750 clamp(40px,5vw,60px)/1.08 'Manrope',sans-serif;letter-spacing:-.05em}
  .category-header>p:last-child{margin:0;color:#566174;font-size:18px;line-height:1.6}
  .article-list{display:grid;gap:20px;max-width:940px}
  .category-article{display:grid;grid-template-columns:minmax(240px,.8fr) 1.2fr;gap:26px;align-items:center;padding:18px;border:1px solid #e2e6ed;border-radius:16px;background:#fff;transition:transform .2s,box-shadow .2s}
  .category-article:hover{transform:translateY(-2px);box-shadow:0 12px 30px #17233f12}
  .article-image{display:block;overflow:hidden;aspect-ratio:16/9;border-radius:11px;background:#e4e8ed}
  .article-image img{width:100%;height:100%;object-fit:cover;transition:transform .3s}
  .category-article:hover .article-image img{transform:scale(1.025)}
  .article-label{margin:0 0 8px;color:#4263d5;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
  .article-copy h2{margin:0 0 9px;color:#171b24;font:700 24px/1.28 'Manrope',sans-serif;letter-spacing:-.035em}
  .article-copy h2 a:hover{color:#4263d5}
  .article-summary{margin:0;color:#566174;font-size:16px;line-height:1.6}
  .article-meta{display:flex;flex-wrap:wrap;gap:8px 16px;margin-top:15px;color:#687386;font-size:13px}
  .empty-state{max-width:760px;padding:34px;border:1px solid #e2e6ed;border-radius:16px;background:#fff}
  .empty-state h2{margin:0 0 9px;color:#171b24;font:700 24px/1.3 'Manrope',sans-serif}
  .empty-state p{margin:0;color:#566174;font-size:16px;line-height:1.6}
  @media(max-width:700px){.category-page{padding:28px 20px 68px}.breadcrumbs{margin-bottom:32px;font-size:13px}.category-header{margin-bottom:32px}.category-header>p:last-child{font-size:17px}.category-article{grid-template-columns:1fr;gap:18px;padding:14px}.article-copy h2{font-size:21px}.article-meta{font-size:12px}.empty-state{padding:25px}}
</style>
