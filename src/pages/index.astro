---
import Layout from '../layouts/Layout.astro';
import { bestPicks, categories } from '../data/homepage';
import { articles } from '../data/articles';
const photo = (id: string, width = 900) => `https://images.unsplash.com/${id}?auto=format&fit=crop&w=${width}&q=84`;
---

<Layout title="NOVIQ — Smarter Tech Choices Start Here" description="Discover expert insights, thoughtful reviews, and practical buying guides to help you choose technology that truly adds value.">
	<main>
		<section class="hero wrap">
			<div class="hero-copy"><h1><span class="headline-line">Tech,</span><span class="headline-line headline-accent">Made Smarter!</span></h1><p>Discover expert insights, thoughtful reviews, and practical buying guides to help you choose technology that truly adds value.</p><div class="hero-actions"><a class="button button-primary" href="#latest-reviews">Explore Reviews <span>↗</span></a><a class="text-link" href="#best-picks">Browse Best Picks <span>→</span></a></div></div>
			<div class="hero-visual" data-light-sweep><img src="/images/noviq-hero.png" alt="A calm blue-gray workspace with a laptop, headphones, and desktop speaker" fetchpriority="high"/><div class="visual-shade" aria-hidden="true"></div><div class="light-sweep" aria-hidden="true"></div></div>
		</section>

		<section class="latest-section" id="latest-reviews"><div class="wrap section"><div class="section-heading"><div><h2>Latest Reviews</h2><p>Clear, useful context for the products on your radar.</p></div><a class="section-link" href="/reviews/">All reviews <span>↗</span></a></div><div class="latest-layout">{articles.slice(0, 4).map((article) => { const articleHref = `/reviews/${article.slug}/`; return <article class="latest-item"><a href={articleHref} class="latest-thumb"><img src={article.coverImage} alt={article.coverAlt} loading="lazy"/></a><div class="latest-copy"><div class="card-meta"><span>{article.category}</span><span>{article.demo === false ? 'Review' : 'Demonstration article'}</span></div><h3><a href={articleHref}>{article.title}</a></h3><p>{article.summary}</p><a class="read-link" href={articleHref}>Read Review <span>→</span></a></div></article>; })}</div></div></section>

		<section class="picks-section" id="best-picks"><div class="wrap section"><div class="section-heading"><div><h2>Best Picks</h2><p>Helpful shortlists for your next considered purchase.</p></div><a class="section-link" href="/best-picks">Explore all guides <span>↗</span></a></div><div class="picks-grid">{bestPicks.map((item, i) => <article class="pick-card"><a href={`/best-picks/${i + 1}`} class="pick-image"><img src={photo(item.image, 800)} alt={item.alt} style={`object-position:${item.position}`} loading="lazy"/><span class="pick-open">↗</span></a><div class="pick-copy"><h3><a href={`/best-picks/${i + 1}`}>{item.title}</a></h3><p>{item.copy}</p><a class="read-link" href={`/best-picks/${i + 1}`}>View the guide <span>→</span></a></div></article>)}</div><p class="demo-note">Editorial previews for demonstration purposes. No product ratings, pricing, or purchase links are shown.</p></div></section>

		<section class="category-section"><div class="wrap section"><div class="section-heading"><div><span class="eyebrow">FIND YOUR NEXT READ</span><h2>Explore categories</h2><p>Explore the technology you use every day.</p></div><a class="section-link" href="/categories">All categories <span>↗</span></a></div><div class="category-grid">{categories.map((item, i) => <a href={item.href} class="category-card"><span class="category-count">0{i + 1}</span><span class="category-icon" aria-hidden="true">{item.icon === 'smartphone' ? <svg viewBox="0 0 48 48"><rect x="14" y="4" width="20" height="40" rx="4"/><path d="M21 9h6m-5 29h4"/></svg> : item.icon === 'computer' ? <svg viewBox="0 0 48 48"><rect x="5" y="6" width="38" height="27" rx="3"/><path d="M18 42h12m-6-9v9"/></svg> : item.icon === 'headphones' ? <svg viewBox="0 0 48 48"><path d="M8 27v-5a16 16 0 0 1 32 0v5"/><path d="M8 25h7v15h-4a4 4 0 0 1-4-4zm32 0h-7v15h4a4 4 0 0 0 4-4z"/></svg> : <svg viewBox="0 0 48 48"><rect x="11" y="5" width="26" height="38" rx="10"/><circle cx="24" cy="25" r="7"/><circle cx="24" cy="25" r="2"/><path d="M21 11h6"/></svg>}</span><span class="category-title">{item.title}</span><span class="category-arrow">↗</span></a>)}</div></div></section>

		<section class="newsletter-section"><div class="wrap newsletter"><div class="newsletter-icon">N<span>.</span></div><div class="newsletter-copy"><span class="eyebrow">THE NOVIQ NOTE</span><h2>Stay ahead of what’s next.</h2><p>Get practical tech insights and buying advice delivered to your inbox.</p></div><form class="newsletter-form" onsubmit="return false"><label class="sr-only" for="email">Email address</label><input id="email" type="email" placeholder="Your email address" autocomplete="email"/><button type="submit" aria-label="Subscribe">Join the list <span>→</span></button><small>Newsletter sign-up is a visual preview and is not active yet.</small></form></div></section>
	</main>
</Layout>

<style>
	.wrap{width:min(1180px,calc(100% - 72px));margin-inline:auto}.hero{min-height:640px;display:grid;grid-template-columns:.78fr 1.22fr;align-items:center;gap:44px;padding-block:58px 72px;position:relative}.hero-copy{padding:0 0 0 10px}.eyebrow{font-size:10px;letter-spacing:1.5px;font-weight:700;color:var(--muted)}.hero-copy>.eyebrow{display:flex;align-items:center;gap:10px;color:#526079}.hero-copy>.eyebrow i{width:7px;height:7px;border-radius:50%;background:var(--blue);box-shadow:0 0 0 4px var(--blue-soft)}.hero h1{font:700 clamp(48px,5.5vw,72px)/1.06 'Manrope',sans-serif;letter-spacing:-4.5px;margin:26px 0 22px;color:var(--text)}.hero h1 span{color:#53627A}.hero-copy>p{font-size:15px;line-height:1.8;color:var(--muted);max-width:430px;margin:0}.hero-actions{display:flex;align-items:center;gap:25px;margin-top:30px}.button{min-height:49px;padding:0 20px;display:inline-flex;align-items:center;gap:26px;font-size:12px;font-weight:600;border-radius:3px}.button-primary{background:var(--blue);color:#fff;transition:transform .2s,background .2s}.button-primary:hover{background:#3452bb;transform:translateY(-2px)}.button-primary span{font-size:17px}.text-link,.section-link{font-size:12px;font-weight:600;color:#344256}.text-link span,.section-link span{margin-left:8px;color:var(--blue)}.hero-note{display:flex;align-items:center;gap:12px;margin-top:48px;font-size:10px;line-height:1.7;color:#8390a0}.hero-note b{font-weight:600;color:#5c6a7b}.note-mark{display:grid;place-items:center;width:32px;height:32px;border:1px solid #d8dfe9;border-radius:50%;font:700 13px 'Manrope';color:var(--blue)}.hero-visual{height:478px;position:relative;border-radius:4px;overflow:hidden;margin-right:10px;background:var(--dark);box-shadow:0 20px 45px #17233f1c}.hero-visual>img{width:100%;height:100%;object-fit:cover;object-position:center 48%}.visual-shade{position:absolute;inset:0;background:linear-gradient(0deg,#10141dcc 0%,transparent 52%),linear-gradient(90deg,#10141d24,transparent 55%)}.visual-caption{position:absolute;left:30px;bottom:28px;color:#fff;display:grid;gap:7px}.visual-caption span{font-size:9px;letter-spacing:1.6px;opacity:.75}.visual-caption b{font:500 21px 'Manrope';letter-spacing:-.5px}.visual-index{position:absolute;top:22px;right:22px;display:flex;align-items:center;gap:9px;color:#fff;font-size:9px;letter-spacing:1px}.visual-index>span:first-child{font-weight:700}.index-line{width:32px;height:1px;background:#ffffff99}.floating-card{position:absolute;right:18px;top:20px;width:180px;padding:18px;background:#171B24ed;color:#fff;border:1px solid #ffffff26;display:grid;gap:9px}.float-kicker{font-size:8px;letter-spacing:1.3px;color:#b8c3d6}.floating-card b{font:600 15px/1.35 'Manrope';letter-spacing:-.3px}.float-arrow{position:absolute;right:14px;bottom:13px;color:#7890ee}.hero-side-label{position:absolute;right:0;bottom:29px;writing-mode:vertical-rl;transform:rotate(180deg);font-size:8px;letter-spacing:1.2px;color:#909ba9}.hero-side-label span{color:var(--blue);margin:8px 0}.trust-strip{background:var(--surface);border-block:1px solid var(--line)}.trust-inner{height:62px;display:flex;align-items:center;justify-content:center;gap:32px;color:#7c8795;font-size:9px;font-weight:700;letter-spacing:1.15px}.trust-inner i{height:4px;width:4px;background:#8ca5df;border-radius:50%}.section{padding-block:82px}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:30px}.section-heading h2{font:650 34px/1.2 'Manrope';letter-spacing:-1.4px;margin:10px 0 8px;color:var(--text)}.section-heading p{color:var(--muted);font-size:13px;margin:0}.section-link{white-space:nowrap;margin-bottom:4px}.featured-grid{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:18px}.review-card{background:var(--surface);border:1px solid var(--line);transition:transform .22s,box-shadow .22s}.review-card:hover,.pick-card:hover{transform:translateY(-4px);box-shadow:0 14px 35px #20314b18}.image-link{aspect-ratio:1.72;position:relative;display:block;overflow:hidden;background:var(--dark)}.review-card-lead .image-link{aspect-ratio:1.55}.image-link img,.pick-image img,.latest-thumb img{width:100%;height:100%;object-fit:cover;transition:transform .45s}.review-card:hover img,.pick-card:hover img{transform:scale(1.035)}.image-label{position:absolute;top:14px;left:14px;padding:7px 9px;background:#171b24e8;color:#fff;font-size:9px;font-weight:700;letter-spacing:.7px;text-transform:uppercase}.image-arrow,.pick-open{position:absolute;right:13px;bottom:13px;width:30px;height:30px;display:grid;place-items:center;background:#fff;color:var(--blue);border-radius:50%}.review-content{padding:19px 20px 21px}.card-meta{display:flex;justify-content:space-between;gap:10px;font-size:9px;letter-spacing:.6px;text-transform:uppercase;color:#8792a0}.review-content h3,.latest-copy h3{font:600 17px/1.42 'Manrope';letter-spacing:-.4px;margin:12px 0 8px;color:var(--text)}.review-content p,.latest-copy p,.pick-copy p{font-size:12px;line-height:1.7;color:var(--muted);margin:0}.read-link{display:inline-flex;align-items:center;gap:8px;margin-top:17px;color:var(--blue);font-size:11px;font-weight:600}.read-link span{font-size:15px;transition:transform .2s}.read-link:hover span{transform:translateX(3px)}
	.picks-section{background:var(--navy);color:#fff}.picks-section .section-heading h2{color:#fff}.picks-section .section-heading p{color:#b5bfd1}.picks-section .eyebrow{color:#a9b9dd}.picks-section .section-link{color:#fff}.picks-section .section-link span{color:#8fa6ff}.picks-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.pick-card{background:#202d4a;border:1px solid #ffffff1c;transition:transform .22s,box-shadow .22s}.pick-image{aspect-ratio:1.8;display:block;position:relative;overflow:hidden;background:#171b24}.pick-number{position:absolute;top:14px;left:15px;font:600 11px 'Manrope';color:#fff;letter-spacing:1px}.pick-open{right:13px;bottom:13px}.pick-copy{padding:19px 20px 22px}.pick-copy>.eyebrow{font-size:9px;color:#91a7ef}.pick-copy h3{font:600 19px/1.35 'Manrope';letter-spacing:-.5px;margin:8px 0;color:#fff}.pick-copy p{color:#bdc6d7}.picks-section .read-link{color:#9cb0ff}.demo-note{font-size:10px;color:#abb8ce;margin:20px 0 0}.latest-section{padding-bottom:88px}.latest-layout{display:grid;grid-template-columns:1.65fr .75fr;gap:64px}.latest-list{border-top:1px solid var(--line)}.latest-item{display:grid;grid-template-columns:175px 1fr;gap:22px;padding:18px 0;border-bottom:1px solid var(--line)}.latest-thumb{aspect-ratio:1.42;overflow:hidden;background:var(--dark)}.latest-copy{padding:4px 0}.latest-copy h3{font-size:16px;margin:10px 0 5px}.latest-copy .read-link{margin-top:10px}.editor-note{padding:24px 0 10px 26px;position:relative;display:flex;flex-direction:column;align-items:flex-start}.note-rule{position:absolute;top:0;left:0;height:100%;width:2px;background:var(--blue)}.editor-note .eyebrow{margin-top:4px}.editor-note blockquote{font:500 23px/1.45 'Manrope';letter-spacing:-.7px;margin:26px 0 12px;color:var(--text)}.editor-note>p{font-size:12px;line-height:1.8;color:var(--muted);margin:0}.editor-note .text-link{margin-top:22px}.note-index{margin-top:auto;padding-top:32px;font-size:8px;letter-spacing:1px;color:#99a2af}.category-section{background:var(--surface);border-block:1px solid var(--line)}.category-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.category-card{height:162px;background:var(--page);border:1px solid var(--line);padding:17px;position:relative;display:flex;flex-direction:column;justify-content:space-between;transition:border-color .2s,transform .2s}.category-card:hover{border-color:#a6b8ef;transform:translateY(-3px)}.category-count{font-size:9px;letter-spacing:1px;color:#9aa4b0}.category-icon{width:34px;height:34px;color:var(--blue)}.category-icon svg{width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}.category-title{font:600 13px 'Manrope';letter-spacing:-.15px;color:var(--text)}.category-arrow{position:absolute;right:17px;bottom:16px;color:var(--blue)}
	.newsletter-section{background:var(--dark);color:#fff}.newsletter{min-height:235px;display:grid;grid-template-columns:58px 1fr 1fr;align-items:center;gap:24px;padding-block:44px}.newsletter-icon{width:48px;height:48px;border:1px solid #ffffff50;border-radius:50%;display:grid;place-items:center;font:800 19px 'Manrope';color:#fff}.newsletter-icon span{color:#8299ff}.newsletter-copy .eyebrow{font-size:9px;color:#a5b7eb}.newsletter-copy h2{font:600 26px 'Manrope';letter-spacing:-1px;margin:9px 0 7px}.newsletter-copy p{font-size:12px;color:#c0c6d2;margin:0}.newsletter-form{display:grid;grid-template-columns:1fr auto;position:relative}.newsletter-form input{height:47px;min-width:0;border:1px solid #ffffff35;border-right:0;background:#202630;color:#fff;padding:0 14px;font-size:12px;outline:none}.newsletter-form input::placeholder{color:#abb2c0}.newsletter-form input:focus{border-color:#91a5ff}.newsletter-form button{border:0;background:var(--blue);color:#fff;padding:0 16px;font-size:11px;cursor:pointer;transition:background .2s}.newsletter-form button:hover{background:#3452bb}.newsletter-form button span{margin-left:9px}.newsletter-form small{grid-column:1/-1;margin-top:9px;font-size:9px;color:#aab1bf}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
	@media(max-width:900px){.wrap{width:calc(100% - 48px)}.hero{gap:28px;grid-template-columns:.84fr 1.16fr;min-height:570px}.hero-visual{height:410px}.hero h1{font-size:56px;letter-spacing:-3.5px}.latest-layout{gap:34px}.latest-item{grid-template-columns:140px 1fr}.newsletter{grid-template-columns:48px 1fr;gap:20px}.newsletter-form{grid-column:2}.featured-grid{gap:12px}.review-content{padding:16px}}
	@media(max-width:640px){.wrap{width:calc(100% - 40px)}.hero{display:flex;flex-direction:column;align-items:stretch;padding-block:46px 53px;gap:34px}.hero h1{font-size:47px;letter-spacing:-2.8px;margin-top:22px}.hero-copy>p{font-size:14px}.hero-actions{gap:18px;flex-wrap:wrap}.hero-note{margin-top:30px}.hero-visual{height:auto;aspect-ratio:1.12;margin:0 10px 0 0}.floating-card{width:150px;right:12px;top:12px;padding:14px}.floating-card b{font-size:14px}.hero-side-label{bottom:0;right:-3px}.trust-inner{height:auto;min-height:58px;justify-content:flex-start;overflow:auto;white-space:nowrap;gap:18px;font-size:8px}.trust-inner i{flex:none}.section{padding-block:58px}.section-heading{align-items:flex-start;margin-bottom:22px}.section-heading h2{font-size:29px}.section-heading p{font-size:12px;max-width:260px;line-height:1.6}.section-link{font-size:10px;margin-top:26px}.featured-grid,.picks-grid{grid-template-columns:1fr;gap:15px}.image-link,.review-card-lead .image-link{aspect-ratio:1.65}.review-card-lead{grid-row:auto}.review-content{padding:18px}.pick-image{aspect-ratio:1.75}.pick-copy{padding:18px}.latest-section{padding-bottom:62px}.latest-layout{grid-template-columns:1fr;gap:36px}.latest-item{grid-template-columns:112px 1fr;gap:14px;padding:15px 0}.latest-thumb{aspect-ratio:1}.latest-copy h3{font-size:14px}.latest-copy p{font-size:11px}.latest-copy .card-meta{font-size:8px}.editor-note{padding-left:19px;min-height:220px}.editor-note blockquote{font-size:21px;margin:18px 0 10px}.note-index{padding-top:20px}.category-grid{grid-template-columns:repeat(2,1fr);gap:10px}.category-card{height:145px;padding:14px}.category-title{font-size:12px}.newsletter{grid-template-columns:40px 1fr;gap:14px;padding-block:38px}.newsletter-icon{width:38px;height:38px;font-size:16px}.newsletter-copy h2{font-size:21px}.newsletter-copy p{line-height:1.6}.newsletter-form{grid-column:1/-1;margin-top:6px}.newsletter-form input{height:45px}.newsletter-form button{padding:0 12px}.demo-note{line-height:1.6}}
</style>

<style>
	/* Keep section titles clean; the article and category labels remain useful context. */
	.section-heading>.eyebrow,.pick-copy>.eyebrow,.newsletter-copy>.eyebrow{display:none}
	.pick-number,.category-count{display:none}
	.hero{min-height:610px;grid-template-columns:.88fr 1.12fr;gap:42px;padding-block:52px 62px}
	.hero-copy{align-self:center;padding:0 0 0 10px}
	.hero h1{font-size:clamp(56px,5.25vw,68px);line-height:1.08;letter-spacing:-.052em;margin:0 0 25px;white-space:nowrap}
	.hero h1 .headline-line{display:block;color:var(--text)}
	.hero h1 .headline-accent{color:#53627A}
	.hero-copy>p{font-size:18px;line-height:1.65;max-width:460px;margin:0}
	.hero-actions{gap:28px;margin-top:34px}
	.hero-visual{height:440px;margin:0;isolation:isolate}
	.hero-visual>img{object-position:center 48%}
	.visual-shade{z-index:1;background:linear-gradient(0deg,#10141d38,transparent 46%)}
	.light-sweep{position:absolute;z-index:2;inset:-20% -35%;pointer-events:none;opacity:0;background:linear-gradient(108deg,transparent 40%,#dceaff05 46%,#dceaff32 49%,#8ab8ff42 50%,#eaf4ff24 52%,transparent 59%);mix-blend-mode:screen;transform:translateX(-62%);filter:blur(10px)}
	.hero-visual.is-visible .light-sweep{animation:studio-sweep 9s cubic-bezier(.45,0,.35,1) infinite}
	@keyframes studio-sweep{0%,12%{opacity:0;transform:translateX(-62%)}24%{opacity:.8}68%{opacity:.68;transform:translateX(62%)}82%,100%{opacity:0;transform:translateX(62%)}}
	@media(max-width:1100px){.hero h1{font-size:clamp(48px,5.2vw,60px);letter-spacing:-.05em}.hero{grid-template-columns:.9fr 1.1fr;gap:30px}}
	@media(max-width:760px){.hero{min-height:0;grid-template-columns:1fr;gap:32px;padding-block:48px 56px}.hero-copy{padding:0}.hero h1{font-size:clamp(37px,7.4vw,54px);letter-spacing:-.045em;white-space:normal}.hero h1 .headline-line{white-space:nowrap}.hero-copy>p{font-size:17px}.hero-visual{height:auto;aspect-ratio:1.5}.hero-actions{margin-top:28px}}
	@media(max-width:420px){.hero h1{font-size:clamp(32px,7.8vw,37px);letter-spacing:-.05em}.hero-visual{aspect-ratio:1.18}.hero-actions{gap:18px}.hero .button{padding-inline:17px}}
	@media(prefers-reduced-motion:reduce){.light-sweep{display:none!important}.hero-visual.is-visible .light-sweep{animation:none!important}}
	/* Wide editorial hero: copy stays on the clear side of the crop. */
	.hero{width:100%;max-width:none;min-height:650px;padding:70px max(6vw,32px);display:flex;align-items:center;background:#edf0f3;overflow:hidden}
	.hero-copy{width:min(1180px,100%);margin-inline:auto;position:relative;z-index:3;padding:0 49% 0 0}
	.hero h1{font-size:clamp(58px,5.2vw,68px);white-space:nowrap;text-shadow:0 1px 0 #ffffff70}
	.hero-copy>p{max-width:510px}
	.hero-visual{position:absolute;z-index:1;inset:0;width:100%;height:100%;border-radius:0;box-shadow:none;margin:0;background:#d9dde2}
	.hero-visual>img{object-position:center 52%;filter:brightness(1.14) contrast(.97);}
	.visual-shade{z-index:1;background:linear-gradient(90deg,#edf0f3 0%,#edf0f3f5 26%,#edf0f3d9 39%,#edf0f360 54%,transparent 72%),linear-gradient(0deg,#14192220,transparent 50%)}
	.light-sweep{inset:-25% -20%;background:linear-gradient(106deg,transparent 42%,#f4f8ff04 46%,#d9eaff44 49%,#ffffffa1 50%,#9fc4ff55 52%,transparent 58%);filter:blur(12px)}
	.latest-section{background:var(--navy);color:#fff}
	.latest-section .section-heading h2,.latest-section .latest-copy h3,.latest-section .editor-note blockquote{color:#fff}
	.latest-section .section-heading p,.latest-section .latest-copy p,.latest-section .editor-note>p{color:#c5cede}
	.latest-section .section-link,.latest-section .text-link{color:#fff}
	.latest-section .section-link span,.latest-section .text-link span,.latest-section .read-link{color:#a8baff}
	.latest-section .latest-list{border-color:#ffffff25}
	.latest-section .latest-item{border-color:#ffffff25}
	.latest-section .card-meta{color:#b6c2d6}
	.latest-section .latest-thumb{aspect-ratio:1.6;border-radius:3px}
	.latest-section .editor-note{border-left:1px solid #ffffff30}
	.latest-section .note-rule{display:none}
	.picks-section{background:#edf0f4;color:var(--text)}
	.picks-section .section-heading h2{color:var(--text)}
	.picks-section .section-heading p{color:var(--muted)}
	.picks-section .section-link{color:var(--text)}
	.picks-section .pick-card{background:#fff;color:var(--text);border-color:var(--line)}
	.picks-section .pick-copy h3{color:var(--text)}
	.picks-section .pick-copy p{color:#566174}
	.picks-section .read-link{color:var(--blue)}
	.picks-section .demo-note{color:#687386}
	@media(max-width:760px){.hero{min-height:0;padding:48px 20px 44px;display:flex}.hero-copy{padding:0;width:100%}.hero-copy>p{max-width:470px}.hero-visual{position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto}.hero-visual>img{object-position:60% center}.visual-shade{background:linear-gradient(90deg,#edf0f3 0%,#edf0f3ed 40%,#edf0f3a8 68%,#edf0f325 100%),linear-gradient(0deg,#edf0f355,transparent 70%)}.latest-section .latest-layout{grid-template-columns:1fr}.latest-section .editor-note{border-left:1px solid #ffffff30}}

