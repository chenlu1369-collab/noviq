---
interface Props { title?: string; description?: string }
const { title = 'NOVIQ — Explore Technology. Discover Value.', description = 'Thoughtful technology reviews, practical buying guides, and clear insights to help you make smarter tech choices.' } = Astro.props;
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#F5F6F8" />
		<link rel="icon" type="image/png" href="/favicon-nq.png" sizes="96x96" />
		<link rel="preconnect" href="https://images.unsplash.com" />
		<title>{title}</title>
	</head>
	<body>
		<SiteHeader />
		<slot />
		<SiteFooter />
	</body>
</html>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
	:root{font-family:'DM Sans',Arial,sans-serif;color:var(--text);background:var(--page);font-synthesis:none;text-rendering:optimizeLegibility;--page:#F5F6F8;--surface:#FFFFFF;--text:#171B24;--muted:#687386;--dark:#171B24;--navy:#17233F;--blue:#4263D5;--line:#E2E6ED;--blue-soft:#E9EEFC}
	*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-width:320px}a{color:inherit;text-decoration:none}button,input{font:inherit}img{display:block;max-width:100%}::selection{background:#d9e4ff}
	.site-header{height:96px;padding:0 max(5.5vw,24px);display:grid;grid-template-columns:1fr auto 1fr;align-items:center;background:var(--surface);border-bottom:1px solid var(--line);position:relative;z-index:20;overflow:visible}.wordmark{display:inline-flex;align-items:center;width:max-content;line-height:0}.wordmark img{width:230px;height:auto;object-fit:contain;object-position:left center}.site-header nav{display:flex;align-items:center;gap:clamp(26px,3vw,40px);height:100%;font-size:17.5px;font-weight:600;color:var(--muted)}.site-header nav> a,.nav-dropdown-trigger{height:100%;display:flex;align-items:center;position:relative;transition:color .2s;color:inherit}.site-header nav> a:hover,.nav-dropdown-trigger:hover,.nav-dropdown:focus-within .nav-dropdown-trigger{color:var(--text)}.site-header nav> a.active,.nav-dropdown .nav-dropdown-trigger.active{color:var(--blue)}.site-header nav> a.active:after,.nav-dropdown .nav-dropdown-trigger.active:after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--blue)}.nav-dropdown{position:relative;display:flex;align-items:center;height:100%}.nav-dropdown-trigger{gap:8px;padding:0;border:0;background:transparent;font:inherit;cursor:pointer}.nav-caret{width:7px;height:7px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:translateY(-2px) rotate(45deg);transition:transform .2s}.nav-dropdown-trigger[aria-expanded="true"] .nav-caret{transform:translateY(2px) rotate(225deg)}.nav-dropdown-menu{position:absolute;z-index:30;top:calc(100% - 1px);left:-18px;display:grid;gap:4px;width:238px;padding:10px;border:1px solid #e2e6ed;border-radius:12px;background:#fff;box-shadow:0 16px 38px #17233f1c}.nav-dropdown-menu[hidden]{display:none}.nav-dropdown-menu a{min-height:44px;padding:10px 12px;display:flex;align-items:center;justify-content:space-between;gap:12px;border-radius:8px;color:#344054;font-size:15px;font-weight:600;transition:background .18s,color .18s}.nav-dropdown-menu a span{color:#4263d5;font-size:14px}.nav-dropdown-menu a:hover,.nav-dropdown-menu a:focus-visible,.nav-dropdown-menu a.active{background:#edf1fa;color:#344fae;outline:none}.search-link{justify-self:end;display:flex;align-items:center;gap:10px;color:var(--muted);font-size:15px}.search-link svg{width:20px;fill:none;stroke:currentColor;stroke-width:1.7}
	.site-footer{padding:48px max(5.5vw,24px) 20px;background:var(--surface);border-top:1px solid var(--line)}.footer-top{display:flex;justify-content:space-between;gap:36px;padding-bottom:36px}.footer-mark{display:inline-block}.footer-top p{color:var(--muted);font-size:15px;line-height:1.6;margin:12px 0}.footer-links{display:flex;gap:25px;align-items:flex-start;flex-wrap:wrap;font-size:14px;color:var(--muted)}.footer-links a:hover{color:var(--blue)}.footer-bottom{border-top:1px solid var(--line);padding-top:16px;display:flex;justify-content:space-between;color:#687386;font-size:13px}
	@media(max-width:760px){.site-header{height:auto;min-height:68px;grid-template-columns:1fr auto;padding:16px 22px;row-gap:12px}.wordmark img{width:180px;height:auto}.site-header nav{grid-column:1/-1;grid-row:2;display:flex;flex-wrap:wrap;overflow:visible;gap:8px 20px;height:auto;white-space:normal;font-size:15px}.site-header nav> a,.nav-dropdown-trigger{height:32px}.nav-dropdown{height:32px}.nav-dropdown-menu{top:calc(100% + 6px);left:0;width:min(238px,calc(100vw - 44px))}.nav-dropdown-menu a{height:auto;min-height:44px}.site-header nav> a.active:after{bottom:-1px}.footer-top{flex-direction:column}.footer-links{gap:16px 22px}.footer-bottom{gap:12px;flex-direction:column;font-size:12px}}
</style>
